    "/carts/{productId}": {
      "patch": {
        "tags": [
          "Carts"
        ],
        "summary": "Update cart item quantity",
        "parameters": [
          {
            "in": "path",
            "name": "productId",
            "required": true,
            "schema": {
              "type": "string"
            }
